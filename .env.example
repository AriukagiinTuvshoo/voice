# Server-only Azure Speech credentials. Never use NEXT_PUBLIC_ for these.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Non-secret provider preference. "cloud" uses Azure Speech; "browser" uses Web Speech API.
NEXT_PUBLIC_SPEECH_PROVIDER=cloud

# History persistence mode. "local" is the safe default.
NEXT_PUBLIC_HISTORY_PERSISTENCE_MODE=local

# Browser-safe Supabase configuration. Required only for explicit cloud mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
